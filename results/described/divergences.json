{
  "probes": [
    {
      "label": "Timestamp: z.iso.datetime({ offset: true }) vs v.isoTimestamp()",
      "fix": "Valibot schemas add v.check(isStrictTimestamp).",
      "rows": [
        {
          "input": "2026-03-10T14:00:00Z",
          "zod": true,
          "valibot": true
        },
        {
          "input": "2026-03-10 14:00:00Z",
          "zod": false,
          "valibot": true
        },
        {
          "input": "2026-02-30T14:00:00Z",
          "zod": false,
          "valibot": true
        },
        {
          "input": "2026-03-10T14:00:00+0100",
          "zod": false,
          "valibot": true
        },
        {
          "input": "2026-03-10T14:00Z",
          "zod": false,
          "valibot": false
        }
      ]
    },
    {
