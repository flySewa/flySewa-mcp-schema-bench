{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "ticketIds": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "IDs of the tickets to update."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "pending",
        "resolved",
        "closed"
      ],
      "description": "New ticket status."
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "description": "New ticket priority."
    },
    "labels": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "bug",
          "billing",
          "feature-request",
          "account",
          "outage"
        ]
      },
      "description": "Labels to apply."
    },
    "notify": {
      "default": [
        "email"
      ],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "email",
          "sms",
          "push",
          "slack"
        ]
      },
      "description": "Channels used to notify watchers."
    },
    "assigneeIds": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "IDs of agents to assign."
    }
  },
  "required": [
    "ticketIds"
  ]
}
