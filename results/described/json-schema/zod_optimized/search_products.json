{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Free-text search query."
    },
    "filters": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "electronics",
            "books",
            "clothing",
            "home",
            "toys"
          ],
          "description": "Restrict results to one category."
        },
        "minPrice": {
          "type": "number",
          "minimum": 0,
          "description": "Minimum price in USD."
        },
        "maxPrice": {
          "type": "number",
          "minimum": 0,
          "description": "Maximum price in USD."
        },
        "inStock": {
          "type": "boolean",
          "description": "Only return products that are in stock."
        },
        "tags": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "description": "Only return products that carry all of these tags."
        }
      },
      "description": "Optional filters that narrow the results."
    },
    "sort": {
      "default": "relevance",
      "type": "string",
      "enum": [
        "relevance",
        "price_asc",
        "price_desc",
        "newest"
      ],
      "description": "Sort order for the results."
    },
    "limit": {
      "default": 20,
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Maximum number of results to return."
    },
    "page": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Page number, starting at 1."
    }
  },
  "required": [
    "query"
  ]
}
