{
  "result": {
    "tools": [
      {
        "name": "register_user",
        "title": "Register user",
        "description": "Create a new user account.",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Full display name of the user."
            },
            "email": {
              "type": "string",
              "format": "email",
              "description": "Email address used to sign in."
            },
            "age": {
              "type": "integer",
              "minimum": 13,
              "maximum": 120,
              "description": "Age in whole years. Must be at least 13."
            }
          },
          "required": [
            "name",
            "email",
            "age"
          ]
        }
      },
      {
        "name": "schedule_event",
        "title": "Schedule event",
        "description": "Schedule a calendar event between two points in time.",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Short title shown on the calendar."
            },
            "startsAt": {
              "type": "string",
              "format": "date-time",
              "description": "Start time as an ISO 8601 timestamp with a UTC offset."
            },
            "endsAt": {
              "type": "string",
              "format": "date-time",
              "description": "End time as an ISO 8601 timestamp with a UTC offset. Must be after startsAt."
            },
            "date": {
              "type": "string",
              "format": "date",
              "description": "Calendar date the event belongs to (YYYY-MM-DD)."
            },
            "attendees": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "format": "email"
              },
              "description": "Email addresses of people to invite."
            },
            "reminderMinutes": {
              "default": 15,
              "type": "integer",
              "minimum": 0,
              "maximum": 10080,
              "description": "Minutes before the start to send a reminder."
            }
          },
          "required": [
            "title",
            "startsAt",
            "endsAt"
          ]
        }
      },
      {
        "name": "search_products",
        "title": "Search products",
        "description": "Search the product catalog with optional filters.",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "description": "Free-text search query."
            },
            "filters": {
              "type": "object",
              "properties": {
                "category": {
                  "type": "string",
                  "enum": [
                    "electronics",
                    "books",
                    "clothing",
                    "home",
                    "toys"
                  ],
                  "description": "Restrict results to one category."
                },
                "minPrice": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Minimum price in USD."
                },
                "maxPrice": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Maximum price in USD."
                },
                "inStock": {
                  "type": "boolean",
                  "description": "Only return products that are in stock."
                },
                "tags": {
                  "maxItems": 10,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50
                  },
                  "description": "Only return products that carry all of these tags."
                }
              },
              "description": "Optional filters that narrow the results."
            },
            "sort": {
              "default": "relevance",
              "type": "string",
              "enum": [
                "relevance",
                "price_asc",
                "price_desc",
                "newest"
              ],
              "description": "Sort order for the results."
            },
            "limit": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Maximum number of results to return."
            },
            "page": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Page number, starting at 1."
            }
          },
          "required": [
            "query"
          ]
        }
      },
      {
        "name": "update_config",
        "title": "Update service configuration",
        "description": "Update the deployment configuration of a service.",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "service": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "description": "Service identifier in lowercase kebab-case."
            },
            "environment": {
              "type": "string",
              "enum": [
                "development",
                "staging",
                "production"
              ],
              "description": "Target deployment environment."
            },
            "database": {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "description": "Database host name."
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535,
                  "description": "Database port."
                },
                "pool": {
                  "type": "object",
                  "properties": {
                    "min": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100,
                      "description": "Minimum open connections."
                    },
                    "max": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100,
                      "description": "Maximum open connections."
                    }
                  },
                  "required": [
                    "min",
                    "max"
                  ],
                  "description": "Connection pool limits."
                }
              },
              "required": [
                "host",
                "port",
                "pool"
              ],
              "description": "Database connection settings."
            },
            "cache": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Whether the cache is enabled."
                },
                "ttlSeconds": {
                  "default": 300,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 86400,
                  "description": "Cache entry lifetime in seconds."
                }
              },
              "required": [
                "enabled"
              ],
              "description": "Optional cache settings."
            },
            "featureFlags": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "boolean"
              },
              "description": "Feature flag names mapped to on or off."
            },
            "logging": {
              "type": "object",
              "properties": {
                "level": {
                  "default": "info",
                  "type": "string",
                  "enum": [
                    "debug",
                    "info",
                    "warn",
                    "error"
                  ],
                  "description": "Minimum log level."
                },
                "format": {
                  "default": "json",
                  "type": "string",
                  "enum": [
                    "json",
                    "text"
                  ],
                  "description": "Log output format."
                }
              },
              "description": "Logging settings."
            },
            "webhookUrl": {
              "type": "string",
              "format": "uri",
              "description": "Optional URL notified after the change is applied."
            }
          },
          "required": [
            "service",
            "environment",
            "database",
            "logging"
          ]
        }
      },
      {
        "name": "bulk_update_tickets",
        "title": "Bulk update tickets",
        "description": "Apply the same change to several support tickets.",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "ticketIds": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "description": "IDs of the tickets to update."
            },
            "status": {
              "type": "string",
              "enum": [
                "open",
                "pending",
                "resolved",
                "closed"
              ],
              "description": "New ticket status."
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "urgent"
              ],
              "description": "New ticket priority."
            },
            "labels": {
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "bug",
                  "billing",
                  "feature-request",
                  "account",
                  "outage"
                ]
              },
              "description": "Labels to apply."
            },
            "notify": {
              "default": [
                "email"
              ],
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "email",
                  "sms",
                  "push",
                  "slack"
                ]
              },
              "description": "Channels used to notify watchers."
            },
            "assigneeIds": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "description": "IDs of agents to assign."
            }
          },
          "required": [
            "ticketIds"
          ]
        }
      }
    ]
  },
  "jsonrpc": "2.0",
  "id": 1
}
