            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "age": {
              "type": "integer",
              "minimum": 13,
              "maximum": 120
            }
          },
          "required": [
            "name",
            "email",
            "age"
          ]
        },
        "execution": {
          "taskSupport": "forbidden"
        }
      },
      {
        "name": "schedule_event",
        "title": "Schedule event",
        "description": "Schedule a calendar event between two points in time.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "startsAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "endsAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "date": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            "attendees": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              }
            },
            "reminderMinutes": {
              "default": 15,
              "type": "integer",
              "minimum": 0,
              "maximum": 10080
            }
          },
          "required": [
            "title",
            "startsAt",
            "endsAt"
          ]
        },
        "execution": {
          "taskSupport": "forbidden"
        }
      },
      {
        "name": "search_products",
        "title": "Search products",
        "description": "Search the product catalog with optional filters.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "filters": {
              "type": "object",
              "properties": {
                "category": {
                  "type": "string",
                  "enum": [
                    "electronics",
                    "books",
                    "clothing",
                    "home",
                    "toys"
                  ]
                },
                "minPrice": {
                  "type": "number",
                  "minimum": 0
                },
                "maxPrice": {
                  "type": "number",
                  "minimum": 0
                },
                "inStock": {
                  "type": "boolean"
                },
                "tags": {
                  "maxItems": 10,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50
                  }
                }
              }
            },
            "sort": {
              "default": "relevance",
              "type": "string",
              "enum": [
                "relevance",
                "price_asc",
                "price_desc",
                "newest"
              ]
            },
            "limit": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "page": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "query"
          ]
        },
        "execution": {
          "taskSupport": "forbidden"
        }
      },
      {
        "name": "update_config",
        "title": "Update service configuration",
        "description": "Update the deployment configuration of a service.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "service": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "environment": {
              "type": "string",
              "enum": [
                "development",
                "staging",
                "production"
              ]
            },
            "database": {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "pool": {
                  "type": "object",
                  "properties": {
                    "min": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "max": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    }
                  },
                  "required": [
                    "min",
                    "max"
                  ]
                }
              },
              "required": [
                "host",
                "port",
                "pool"
              ]
            },
            "cache": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "ttlSeconds": {
                  "default": 300,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 86400
                }
              },
              "required": [
                "enabled"
              ]
            },
            "featureFlags": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "logging": {
              "type": "object",
              "properties": {
                "level": {
                  "default": "info",
                  "type": "string",
                  "enum": [
                    "debug",
                    "info",
                    "warn",
                    "error"
                  ]
                },
                "format": {
                  "default": "json",
                  "type": "string",
                  "enum": [
                    "json",
                    "text"
                  ]
                }
              }
            },
            "webhookUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "service",
            "environment",
            "database",
            "logging"
          ]
        },
        "execution": {
          "taskSupport": "forbidden"
        }
      },
      {
        "name": "bulk_update_tickets",
        "title": "Bulk update tickets",
        "description": "Apply the same change to several support tickets.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "ticketIds": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
              }
            },
            "status": {
              "type": "string",
              "enum": [
                "open",
                "pending",
                "resolved",
                "closed"
              ]
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "urgent"
              ]
            },
            "labels": {
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "bug",
                  "billing",
                  "feature-request",
                  "account",
                  "outage"
                ]
              }
            },
            "notify": {
              "default": [
                "email"
              ],
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "email",
                  "sms",
                  "push",
                  "slack"
                ]
              }
            },
            "assigneeIds": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
              }
            }
          },
          "required": [
            "ticketIds"
          ]
        },
        "execution": {
          "taskSupport": "forbidden"
        }
      }
    ]
  },
  "jsonrpc": "2.0",
  "id": 1
}
