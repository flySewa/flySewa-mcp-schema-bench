{
  "result": {
    "tools": [
      {
        "name": "register_user",
        "title": "Register user",
        "description": "Create a new user account.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "age": {
              "type": "integer",
              "minimum": 13,
              "maximum": 120
            }
          },
          "required": [
            "name",
            "email",
            "age"
          ],
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      {
        "name": "schedule_event",
        "title": "Schedule event",
        "description": "Schedule a calendar event between two points in time.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "startsAt": {
              "type": "string",
              "format": "date-time"
            },
            "endsAt": {
              "type": "string",
              "format": "date-time"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "attendees": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "email"
              },
              "maxItems": 50
            },
            "reminderMinutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10080,
              "default": 15
            }
          },
          "required": [
            "title",
            "startsAt",
            "endsAt"
          ],
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      {
        "name": "search_products",
        "title": "Search products",
        "description": "Search the product catalog with optional filters.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "filters": {
              "type": "object",
              "properties": {
                "category": {
                  "enum": [
                    "electronics",
                    "books",
                    "clothing",
                    "home",
                    "toys"
                  ],
                  "type": "string"
                },
                "minPrice": {
                  "type": "number",
                  "minimum": 0
                },
                "maxPrice": {
                  "type": "number",
                  "minimum": 0
                },
                "inStock": {
                  "type": "boolean"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50
                  },
                  "maxItems": 10
                }
              },
              "required": []
            },
            "sort": {
              "enum": [
                "relevance",
                "price_asc",
                "price_desc",
                "newest"
              ],
              "type": "string",
              "default": "relevance"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "default": 1
            }
          },
          "required": [
            "query"
          ],
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      {
        "name": "update_config",
        "title": "Update service configuration",
        "description": "Update the deployment configuration of a service.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "service": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "environment": {
              "enum": [
                "development",
                "staging",
                "production"
              ],
              "type": "string"
            },
            "database": {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "pool": {
                  "type": "object",
                  "properties": {
                    "min": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "max": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    }
                  },
                  "required": [
                    "min",
                    "max"
                  ]
                }
              },
              "required": [
                "host",
                "port",
                "pool"
              ]
            },
            "cache": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "ttlSeconds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 86400,
                  "default": 300
                }
              },
              "required": [
                "enabled"
              ]
            },
            "featureFlags": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "logging": {
              "type": "object",
              "properties": {
                "level": {
                  "enum": [
                    "debug",
                    "info",
                    "warn",
                    "error"
                  ],
                  "type": "string",
                  "default": "info"
                },
                "format": {
                  "enum": [
                    "json",
                    "text"
                  ],
                  "type": "string",
                  "default": "json"
                }
              },
              "required": []
            },
            "webhookUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "service",
            "environment",
            "database",
            "logging"
          ],
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      {
        "name": "bulk_update_tickets",
        "title": "Bulk update tickets",
        "description": "Apply the same change to several support tickets.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "ticketIds": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 1,
              "maxItems": 100
            },
            "status": {
              "enum": [
                "open",
                "pending",
                "resolved",
                "closed"
              ],
              "type": "string"
            },
            "priority": {
              "enum": [
                "low",
                "medium",
                "high",
                "urgent"
              ],
              "type": "string"
            },
            "labels": {
              "type": "array",
              "items": {
                "enum": [
                  "bug",
                  "billing",
                  "feature-request",
                  "account",
                  "outage"
                ],
                "type": "string"
              },
              "maxItems": 5
            },
            "notify": {
              "type": "array",
              "items": {
                "enum": [
                  "email",
                  "sms",
                  "push",
                  "slack"
                ],
                "type": "string"
              },
              "default": [
                "email"
              ]
            },
            "assigneeIds": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "maxItems": 3
            }
          },
          "required": [
            "ticketIds"
          ],
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      }
    ]
  },
  "jsonrpc": "2.0",
  "id": 1
}
