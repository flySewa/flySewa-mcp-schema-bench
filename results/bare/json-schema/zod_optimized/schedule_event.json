{
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "startsAt": {
      "type": "string",
      "format": "date-time"
    },
    "endsAt": {
      "type": "string",
      "format": "date-time"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "attendees": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "format": "email"
      }
    },
    "reminderMinutes": {
      "default": 15,
      "type": "integer",
      "minimum": 0,
      "maximum": 10080
    }
  },
  "required": [
    "title",
    "startsAt",
    "endsAt"
  ]
}
