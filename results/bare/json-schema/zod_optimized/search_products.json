{
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "filters": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "electronics",
            "books",
            "clothing",
            "home",
            "toys"
          ]
        },
        "minPrice": {
          "type": "number",
          "minimum": 0
        },
        "maxPrice": {
          "type": "number",
          "minimum": 0
        },
        "inStock": {
          "type": "boolean"
        },
        "tags": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        }
      }
    },
    "sort": {
      "default": "relevance",
      "type": "string",
      "enum": [
        "relevance",
        "price_asc",
        "price_desc",
        "newest"
      ]
    },
    "limit": {
      "default": 20,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "page": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "query"
  ]
}
