{
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "filters": {
      "type": "object",
      "properties": {
        "category": {
          "enum": [
            "electronics",
            "books",
            "clothing",
            "home",
            "toys"
          ],
          "type": "string"
        },
        "minPrice": {
          "type": "number",
          "minimum": 0
        },
        "maxPrice": {
          "type": "number",
          "minimum": 0
        },
        "inStock": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "maxItems": 10
        }
      },
      "required": []
    },
    "sort": {
      "enum": [
        "relevance",
        "price_asc",
        "price_desc",
        "newest"
      ],
      "type": "string",
      "default": "relevance"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 20
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "default": 1
    }
  },
  "required": [
    "query"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
