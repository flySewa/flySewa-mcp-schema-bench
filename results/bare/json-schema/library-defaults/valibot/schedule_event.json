{
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "startsAt": {
      "type": "string",
      "format": "date-time"
    },
    "endsAt": {
      "type": "string",
      "format": "date-time"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email"
      },
      "maxItems": 50
    },
    "reminderMinutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10080,
      "default": 15
    }
  },
  "required": [
    "title",
    "startsAt",
    "endsAt"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
