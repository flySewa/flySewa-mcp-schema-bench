{
  "type": "object",
  "properties": {
    "service": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "description": "Service identifier in lowercase kebab-case."
    },
    "environment": {
      "enum": [
        "development",
        "staging",
        "production"
      ],
      "type": "string",
      "description": "Target deployment environment."
    },
    "database": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "description": "Database host name."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Database port."
        },
        "pool": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Minimum open connections."
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Maximum open connections."
            }
          },
          "required": [
            "min",
            "max"
          ],
          "description": "Connection pool limits."
        }
      },
      "required": [
        "host",
        "port",
        "pool"
      ],
      "description": "Database connection settings."
    },
    "cache": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether the cache is enabled."
        },
        "ttlSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400,
          "description": "Cache entry lifetime in seconds.",
          "default": 300
        }
      },
      "required": [
        "enabled"
      ],
      "description": "Optional cache settings."
    },
    "featureFlags": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "Feature flag names mapped to on or off."
    },
    "logging": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "type": "string",
          "description": "Minimum log level.",
          "default": "info"
        },
        "format": {
          "enum": [
            "json",
            "text"
          ],
          "type": "string",
          "description": "Log output format.",
          "default": "json"
        }
      },
      "required": [],
      "description": "Logging settings."
    },
    "webhookUrl": {
      "type": "string",
      "format": "uri",
      "description": "Optional URL notified after the change is applied."
    }
  },
  "required": [
    "service",
    "environment",
    "database",
    "logging"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
